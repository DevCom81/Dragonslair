# Backend env placeholders. Do not put real secrets in this file.

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ALLOWED_ORIGINS=

# Stripe Checkout (Web). Leave empty to disable purchases (503 PURCHASE_UNAVAILABLE).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_DRAGONSLAIR_PRICE_ID=
CHECKOUT_SUCCESS_URL=https://example.com/play?purchase=success
CHECKOUT_CANCEL_URL=https://example.com/play?purchase=cancel

# AI anti-abuse (per user_id). Defaults stay high enough for normal play.
# Set both to 0 to disable locally.
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_HOUR=300

# Optional USD estimate if OpenRouter omits usage.cost (per million tokens).
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=

# Cloudflare R2 (private bucket, presigned Windows installer).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_WINDOWS_OBJECT=

# Google Play Billing (Android). Leave empty to disable (503 GOOGLE_PLAY_UNAVAILABLE).
GOOGLE_PLAY_PACKAGE_NAME=com.devcom81.dragons_lair
GOOGLE_PLAY_PRODUCT_ID=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Google Play RTDN (Pub/Sub push). Requires Play Console + GCP topic + push subscription.
# Set audience to the exact push endpoint URL (JWT aud claim).
# Setup: GCP Pub/Sub topic -> Play Console RTDN -> push to /v1/purchases/google-rtdn
GOOGLE_PLAY_RTDN_AUDIENCE=
